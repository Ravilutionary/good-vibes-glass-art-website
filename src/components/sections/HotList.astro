---
import { getCollection } from 'astro:content';
import SectionHeader from '../ui/SectionHeader.astro';
import { STORE_CONFIG } from '../../config/store';

const allProducts = await getCollection('products');
const sortedProducts = allProducts.sort((a, b) => a.data.order - b.data.order);

const categories = ['all', ...new Set(sortedProducts.map(p => p.data.category))];
---
<section id="hot-list" class="py-20 3xl:py-40 4xl:py-56 px-6 max-w-[1800px] 4xl:max-w-[2400px] mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 3xl:mb-24 4xl:mb-32 gap-6">
        <SectionHeader title="The" accentText="Hot List" accentColor="text-purple-vibe" subtitle={`What's trending at ${STORE_CONFIG.address.street.split(' ').slice(1).join(' ')} right now.`} />
        <div class="flex gap-2 4xl:gap-4 overflow-x-auto pb-2 w-full md:w-auto no-scrollbar" id="category-filters">
            {categories.map((cat, idx) => (
                <button class={`category-pill 4xl:text-2xl 4xl:px-8 4xl:py-4 capitalize ${idx === 0 ? 'active' : ''}`} data-filter={cat}>
                    {cat}
                </button>
            ))}
        </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 3xl:gap-12 4xl:gap-16" id="product-grid">
        {sortedProducts.map(product => (
            <article class="hot-card group 4xl:p-12 flex flex-col justify-between" data-category={product.data.category}>
                <div>
                    {product.data.badge && (
                        <div class={`absolute top-6 right-6 4xl:top-8 4xl:right-8 ${product.data.badgeColor} text-[10px] 4xl:text-sm font-black px-3 py-1 4xl:px-5 4xl:py-2 rounded-full uppercase tracking-widest`}>
                            {product.data.badge}
                        </div>
                    )}
                    <div class={`${product.data.iconColor} text-3xl 3xl:text-5xl 4xl:text-7xl mb-6 4xl:mb-10`}>
                        <i class={product.data.icon} aria-hidden="true"></i>
                    </div>
                    <h3 class="text-2xl 3xl:text-4xl 4xl:text-6xl font-black mb-2 4xl:mb-4 uppercase">{product.data.name}</h3>
                    <p class="text-gray-400 text-sm 3xl:text-xl 4xl:text-3xl mb-6 4xl:mb-10">{product.data.description}</p>
                </div>
                <div class="flex justify-between items-center mt-auto pt-4 border-t border-white/5">
                    <span class="text-xl 3xl:text-3xl 4xl:text-5xl font-black text-white">{product.data.price}</span>
                    <a href={`/${product.data.category}`} class="text-xs 3xl:text-lg 4xl:text-2xl font-bold uppercase tracking-widest text-white hover:text-teal-glow transition-colors">
                        View Category <i class="fa-solid fa-arrow-right ml-1" aria-hidden="true"></i>
                    </a>
                </div>
            </article>
        ))}
    </div>
</section>

<script>
    // Category Filtering
    const filterBtns = document.querySelectorAll('.category-pill');
    const products = document.querySelectorAll('.hot-card');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            const filter = btn.getAttribute('data-filter');
            
            products.forEach(product => {
                const el = product as HTMLElement;
                if (filter === 'all' || el.getAttribute('data-category') === filter) {
                    el.style.display = 'flex';
                    setTimeout(() => {
                        el.style.opacity = '1';
                        el.style.transform = 'translateY(0)';
                    }, 50);
                } else {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(20px)';
                    setTimeout(() => {
                        el.style.display = 'none';
                    }, 300);
                }
            });
        });
    });
</script>
