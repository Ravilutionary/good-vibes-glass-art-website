---
import { STORE_CONFIG } from '../../config/store';
const { stats } = STORE_CONFIG;
---
<section class="max-w-[1800px] 4xl:max-w-[2400px] mx-auto px-6 grid grid-cols-2 lg:grid-cols-4 gap-4 3xl:gap-8 4xl:gap-12 mb-20 3xl:mb-40 4xl:mb-56 relative">
    {stats.map(stat => (
        <div class="glass-morphism p-6 3xl:p-12 4xl:p-16 rounded-2xl text-center border-t border-white/5 hover:border-teal-glow/30">
            <div class={`text-3xl 3xl:text-6xl 4xl:text-8xl font-black ${stat.color} mb-1 4xl:mb-4`}>
                {stat.isIcon && stat.icon ? (
                    <i class={stat.icon} aria-hidden="true"></i>
                ) : (
                    stat.value
                )}
            </div>
            <div class="text-[10px] 3xl:text-sm 4xl:text-xl text-gray-400 uppercase font-bold tracking-widest">{stat.label}</div>
        </div>
    ))}
</section>
