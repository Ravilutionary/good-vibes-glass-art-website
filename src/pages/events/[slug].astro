---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AgeGate from '../../components/global/AgeGate.astro';
import Navbar from '../../components/global/Navbar.astro';
import MobileStickyBar from '../../components/global/MobileStickyBar.astro';
import Footer from '../../components/global/Footer.astro';
import { STORE_CONFIG } from '../../config/store';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await event.render();

const displayDate = event.data.endDate 
  ? `${formatDate(event.data.date)} - ${formatDate(event.data.endDate)}`
  : formatDate(event.data.date);

const schema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": event.data.title,
  "startDate": event.data.date.toISOString(),
  "endDate": event.data.endDate ? event.data.endDate.toISOString() : event.data.date.toISOString(),
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": event.data.venue,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": STORE_CONFIG.address.city,
      "addressRegion": STORE_CONFIG.address.state,
      "addressCountry": STORE_CONFIG.address.country
    }
  },
  "description": `Join us for ${event.data.title} at ${event.data.venue}. Stop by ${STORE_CONFIG.name} nearby!`
};
---

<Layout 
  title={`${event.data.title} | Events Near ${STORE_CONFIG.name}`}
  description={`Attending ${event.data.title} at ${event.data.venue}? Visit ${STORE_CONFIG.name} at ${STORE_CONFIG.address.street} for all your glass and smoke accessories.`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <MobileStickyBar />
  <AgeGate />
  <Navbar />
  
  <main class="pt-32 pb-20 px-6 max-w-[1200px] mx-auto min-h-[60vh]">
    <div class="mb-8">
      <a href="/events" class="text-gv-green hover:underline font-bold uppercase tracking-widest text-sm flex items-center gap-2">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to Events
      </a>
    </div>
    
    <div class="bg-charcoal/30 rounded-3xl p-8 md:p-12 border border-white/5">
      <div class="flex flex-wrap gap-4 mb-6">
        <span class="bg-gv-green/20 text-gv-green px-4 py-2 rounded-full font-bold uppercase tracking-widest text-sm">
          {event.data.category}
        </span>
        <span class="bg-white/10 text-white px-4 py-2 rounded-full font-bold uppercase tracking-widest text-sm">
          <i class="fa-regular fa-calendar mr-2 text-gv-green" aria-hidden="true"></i> {displayDate}
        </span>
        {event.data.time && (
          <span class="bg-white/10 text-white px-4 py-2 rounded-full font-bold uppercase tracking-widest text-sm">
            <i class="fa-regular fa-clock mr-2 text-gv-green" aria-hidden="true"></i> {event.data.time}
          </span>
        )}
      </div>
      
      <h1 class="text-4xl md:text-6xl font-black uppercase mb-6">{event.data.title}</h1>
      
      <div class="flex items-center gap-3 text-xl text-gray-300 mb-10 font-bold">
        <i class="fa-solid fa-location-dot text-gv-green" aria-hidden="true"></i>
        <span>{event.data.venue}</span>
      </div>
      
      <div class="prose prose-invert prose-lg max-w-none prose-a:text-gv-green hover:prose-a:text-white mb-12">
        <Content />
      </div>
      
      <div class="bg-deep-black p-8 rounded-2xl border border-gv-green/20 text-center">
        <h3 class="text-2xl font-black uppercase mb-4 text-white">Minutes Away from {STORE_CONFIG.name}</h3>
        <p class="text-gray-400 mb-6">We are located at {STORE_CONFIG.address.formatted}. Stop by before or after the event!</p>
        <a href={STORE_CONFIG.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block vibe-gradient px-8 py-4 rounded-full font-black text-white uppercase tracking-widest hover:scale-105 transition-transform">
          Get Directions
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
