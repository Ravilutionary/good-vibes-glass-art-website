---
import { STORE_CONFIG } from '../config/store';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonical?: string;
}

const { 
	title = `${STORE_CONFIG.name} | ${STORE_CONFIG.taglineSub}`, 
	description = STORE_CONFIG.description,
	image = STORE_CONFIG.logo,
	canonical
} = Astro.props;

const canonicalUrl = canonical || new URL(Astro.url.pathname, STORE_CONFIG.siteUrl).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "SmokeShop",
  "name": STORE_CONFIG.name,
  "image": new URL(image, STORE_CONFIG.siteUrl).href,
  "telephone": STORE_CONFIG.intlPhone,
  "url": STORE_CONFIG.siteUrl,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": STORE_CONFIG.address.street,
    "addressLocality": STORE_CONFIG.address.city,
    "addressRegion": STORE_CONFIG.address.state,
    "postalCode": STORE_CONFIG.address.zip,
    "addressCountry": STORE_CONFIG.address.country
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": STORE_CONFIG.geo.latitude,
    "longitude": STORE_CONFIG.geo.longitude
  },
  "openingHoursSpecification": STORE_CONFIG.hours.schema.map(h => ({
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": h.dayOfWeek,
    "opens": h.opens,
    "closes": h.closes
  })),
  "areaServed": { "@type": "City", "name": STORE_CONFIG.address.city }
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- Theme Stylesheet -->
		<link rel="stylesheet" href={`/themes/${STORE_CONFIG.theme}.css`} />
		
		<!-- Open Graph / Social Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={image} />
		
		<!-- PERFORMANCE: Resource Hints -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preconnect" href="https://cdnjs.cloudflare.com">
		
		<!-- Preload Critical Font -->
		<link rel="preload" href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2" as="font" type="font/woff2" crossorigin>

		<!-- Google Fonts (Synchronous for LCP) -->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Eczar:wght@400;500;600;700;800&display=swap">
		
		<!-- FontAwesome Icons -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

		<!-- DYNAMIC LOCATION SCHEMA -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

		<!-- AGE GATE CHECK (Run immediately to prevent flashing) -->
		<script is:inline define:vars={{ ageGateId: STORE_CONFIG.ageGate.id }}>
			(function() {
				const storedData = localStorage.getItem(ageGateId + '_verified');
				let isVerified = false;
				if (storedData) {
					try {
						const parsed = JSON.parse(storedData);
						if (parsed.verified && parsed.expiry > new Date().getTime()) {
							isVerified = true;
						}
					} catch (e) {
						if (storedData === 'true') isVerified = true;
					}
				}
				if (isVerified) {
					document.documentElement.classList.add('age-verified');
				} else {
					document.documentElement.classList.add('age-unverified');
				}
			})();
		</script>
	</head>
	<body class="bg-gv-black text-white overflow-x-hidden antialiased selection:bg-gv-green selection:text-gv-black font-sans">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[9999] bg-gv-green text-gv-black font-bold px-4 py-2 rounded-lg shadow-xl uppercase tracking-wider text-xs">Skip to main content</a>
		<div id="main-content">
			<slot />
		</div>
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	@layer components {
		.glass-morphism {
			@apply bg-gv-blue/60 backdrop-blur-xl border border-white/10 transition-all duration-300;
		}
		.vibe-gradient {
			@apply bg-gradient-to-br from-gv-blue via-gv-green to-gv-yellow;
		}
		.text-gradient {
			@apply bg-gradient-to-r from-gv-green to-gv-yellow bg-clip-text text-transparent;
		}
		.glow-blur {
			@apply absolute rounded-full opacity-15 blur-[120px] pointer-events-none;
		}
		.nav-link {
			@apply hover:text-white transition-colors text-sm md:text-base 3xl:text-lg font-medium;
		}
		.hero-title {
			font-size: clamp(2.25rem, 6.5vw, 8rem);
			@apply font-display font-black tracking-tight leading-[0.9] mb-4;
		}
		.hot-card {
			@apply bg-gv-black/80 rounded-3xl p-6 3xl:p-10 border border-white/5 hover:border-gv-green/50 transition-all hover:-translate-y-2 relative overflow-hidden;
		}
		.category-pill {
			@apply px-6 py-2 rounded-full text-sm font-bold uppercase tracking-widest border border-white/10 hover:bg-white/10 transition-colors cursor-pointer;
		}
		.category-pill.active {
			@apply bg-white text-black border-white;
		}
		.event-row {
			@apply flex flex-col md:flex-row items-start md:items-center justify-between p-6 3xl:p-10 border-b border-white/5 hover:bg-white/5 transition-colors;
		}
	}
	
	/* Age Gate Display Logic */
	html.age-verified #age-gate {
		display: none !important;
	}
	html.age-unverified body {
		overflow: hidden !important;
	}

	#age-gate { transition: opacity 0.5s ease; }
	
	:focus-visible {
		@apply outline-none ring-2 ring-gv-green ring-offset-4 ring-offset-gv-black;
	}

	.error-shake {
		animation: shake 0.4s ease-in-out;
		@apply border-red-500 !important;
	}

	@keyframes shake {
		0%, 100% { transform: translateX(0); }
		25% { transform: translateX(-5px); }
		75% { transform: translateX(5px); }
	}



	/* Map Styles */
	.map-frame {
		@apply grayscale invert contrast-125 opacity-80 transition-all duration-700 hover:grayscale-0 hover:invert-0 hover:opacity-100;
	}

	/* Hide scrollbar for horizontal scrolling elements */
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.no-scrollbar {
		-ms-overflow-style: none;  /* IE and Edge */
		scrollbar-width: none;  /* Firefox */
	}
</style>
